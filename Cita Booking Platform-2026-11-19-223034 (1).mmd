classDiagram
direction TB

class Usuario {
  <<abstract>>
  -id : String
  -nombre : String
  -correo : String
  -telefono : String
  -salt : String
  -hash : String
  -fechaCreacion : DateTime
  +iniciarSesion(correo : String, clave : String) Sesion
  +cerrarSesion() void
}
class Cliente {
  +agendarCita(servicio : Servicio, fecha : Date, hora : String) Cita
  +consultarMisCitas() List~Cita~
  +cancelarMiCita(cita : Cita) void
}
class Manicurista {
  +verCitas() List~Cita~
  +confirmarCita(cita : Cita) void
  +cancelarCita(cita : Cita) void
}
class Administrador {
  +verClientes() List~Cliente~
  +eliminarCita(cita : Cita) void
  +exportarCitasCSV() File
  +exportarClientesCSV() File
}
class Rol {
  <<enumeration>>
  cliente
  manicurista
  administrador
}
class Servicio {
  -id : String
  -nombre : String
  -descripcion : String
  -precio : Decimal
  -duracionMin : Integer
  -icono : String
  -imagen : String
}
class Cita {
  -id : String
  -nombre : String
  -telefono : String
  -correo : String
  -fecha : Date
  -hora : String
  -notas : String
  -estado : EstadoCita
  -fechaCreacion : DateTime
  +confirmar() void
  +cancelar() void
}
class Estado_Cita {
  <<enumeration>>
  Pendiente
  Confirmada
  Cancelada
}
class Sesion {
  -token : String
  -rol : Rol
  -emitidoEn : DateTime
  -expiraEn : DateTime
  +esValida() Boolean
}
class Servicio_de_autenticacion {
  <<service>>
  -CODIGO_ADMIN : String
  -CODIGO_MANICURISTA : String
  -MAX_INTENTOS : Integer
  +registrar(datos, rol : Rol) Usuario
  +autenticar(correo : String, clave : String) Sesion
  -hashPw(clave : String, salt : String) String
  -crearJWT(usuario : Usuario) String
  +usuarioActual() Usuario
}
class Chatbot {
  <<service>>
  -mensajes : List~String~
  +responder(texto : String) String
  +mostrarServicios() void
  +mostrarPrecios() void
}
class Almacenamiento {
  <<service>>
  -urlApi : String
  +guardar() void
  +cargar() void
}

Usuario <|-- Cliente
Usuario <|-- Manicurista
Usuario <|-- Administrador
Usuario --> "1" Rol : tiene
Cita --> "1" EstadoCita : estado
Cliente "0..1" -- "0..*" Cita : solicita
Cita "0..*" --> "1" Servicio : reserva
Manicurista "0..*" ..> "0..*" Cita : gestiona
Administrador "0..*" ..> "0..*" Cita : administra
Usuario "1" *-- "0..1" Sesion : inicia
Servicio_de_autenticacion ..> Usuario : crea / valida
Servicio_de_autenticacion ..> Sesion : emite
Chatbot ..> Servicio : consulta
Almacenamiento ..> Cita : persiste
Almacenamiento ..> Usuario : persiste
Almacenamiento ..> Servicio : persiste
